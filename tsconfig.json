{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@engine/*": ["./src/engine/*"],
      "@content/*": ["./src/content/*"],
      "@state/*": ["./src/state/*"],
      "@ui/*": ["./src/ui/*"]
    }
  },
  "include": ["src", "test", "balance"]
}
